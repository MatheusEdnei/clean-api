  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "eslint-config-love": "^158.0.0",
    "git-commit-msg-linter": "^5.0.10",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.1",
    "ts-jest": "^29.4.15"
  }
