{
  "name": "clean-api",
  "version": "1.0.0",
  "description": "Repositório contendo o código da api criada no curso NodeJs, Typescript, TDD, DDD, Clean Architecture e SOLID",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "lint": "eslint . --ext .ts",
